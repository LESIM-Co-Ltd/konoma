<svg xmlns="http://www.w3.org/2000/svg" width="#" height="#" viewBox="# # # #">
<rect width="#" height="#" fill="none"/>
<g class="edges">
<path d="M#,#L#,#C#,# #,# #,#C#,# #,# #,#L#,#" fill="none" stroke="#d3d3d3" stroke-width="#"/>
<polygon points="#,# #,# #,#" fill="#1f2020" stroke="#d3d3d3" stroke-width="#"/>
