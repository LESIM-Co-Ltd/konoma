<path d="M#,# L#,# L#,# L#,# L#,# Z" fill="#3d3a2a" stroke="#b8a94e" stroke-width="#"/>
<path d="M#,# L#,# L#,#" fill="none" stroke="#b8a94e" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#f0e6bf"><tspan x="#" dy="#">From Duck till Zebra</tspan></text>
<path d="M#,# L#,# L#,# L#,# L#,# Z" fill="#3d3a2a" stroke="#b8a94e" stroke-width="#"/>
<path d="M#,# L#,# L#,#" fill="none" stroke="#b8a94e" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#f0e6bf"><tspan x="#" dy="#">can fly</tspan><tspan x="#" dy="#">can swim</tspan><tspan x="#" dy="#">can dive</tspan></text>
</g>
