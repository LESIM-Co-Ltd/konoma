=== basic ===
<svg xmlns="http://www.w3.org/2000/svg" width="#" height="#" viewBox="# # # #">
<rect width="#" height="#" fill="none"/>
<g class="lifelines">
<line x1="#" y1="#" x2="#" y2="#" stroke="#8a8a8a" stroke-width="#" stroke-dasharray="# #"/>
<line x1="#" y1="#" x2="#" y2="#" stroke="#8a8a8a" stroke-width="#" stroke-dasharray="# #"/>
</g>
<g class="edges">
<path d="M#,#L#,#" fill="none" stroke="#d3d3d3" stroke-width="#"/>
<polygon points="#,# #,# #,#" fill="#d3d3d3"/>
<path d="M#,#L#,#" fill="none" stroke="#d3d3d3" stroke-width="#" stroke-dasharray="# #"/>
<polygon points="#,# #,# #,#" fill="#d3d3d3"/>
<path d="M#,#L#,#" fill="none" stroke="#d3d3d3" stroke-width="#"/>
<polygon points="#,# #,# #,# #,#" fill="#d3d3d3"/>
</g>
<g class="nodes">
<rect x="#" y="#" width="#" height="#" rx="#" ry="#" fill="#1f2020" stroke="#cccccc" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">Alice</tspan></text>
<rect x="#" y="#" width="#" height="#" rx="#" ry="#" fill="#1f2020" stroke="#cccccc" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">John</tspan></text>
<rect x="#" y="#" width="#" height="#" rx="#" ry="#" fill="#1f2020" stroke="#cccccc" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">Alice</tspan></text>
<rect x="#" y="#" width="#" height="#" rx="#" ry="#" fill="#1f2020" stroke="#cccccc" stroke-width="#"/>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">John</tspan></text>
</g>
<g class="edge-labels">
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">Hello John, how are you?</tspan></text>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">Great!</tspan></text>
<text x="#" y="#" text-anchor="middle" font-family="sans-serif" font-size="#" fill="#cccccc"><tspan x="#" dy="#">See you later!</tspan></text>
</g>
</svg>

