  s01 fg=cyan,bg=-,mod=B "\u{f046} "
  s02 fg=-,bg=-,mod=- "A done task (checked icon; "
  s03 fg=white,bg=-,mod=- "[x]"
  s04 fg=-,bg=-,mod=- " when "
  s05 fg=white,bg=-,mod=- "ui.icons = false"
  s06 fg=-,bg=-,mod=- ")"
L0080 style=fg=-,bg=-,mod=- align=-
L0081 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Checkboxes are interactive: "
  s01 fg=white,bg=-,mod=- "Tab"
  s02 fg=-,bg=-,mod=- " to focus (same cycle as links), then "
  s03 fg=white,bg=-,mod=- "Space"
  s04 fg=-,bg=-,mod=- " or "
  s05 fg=white,bg=-,mod=- "Enter"
  s06 fg=-,bg=-,mod=- " "
  s07 fg=-,bg=-,mod=- "toggles it — written back to this file. "
  s08 fg=white,bg=-,mod=- "[ui] md_task_states"
  s09 fg=-,bg=-,mod=- " can cycle custom states like"
  s10 fg=-,bg=-,mod=- " "
  s11 fg=white,bg=-,mod=- "[\" \", \"/\", \"x\"]"
  s12 fg=-,bg=-,mod=- " (shown as "
  s13 fg=white,bg=-,mod=- "[/]"
  s14 fg=-,bg=-,mod=- " in brackets)."
