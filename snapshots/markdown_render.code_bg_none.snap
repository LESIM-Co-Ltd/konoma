L0060 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "F"
  s02 fg=-,bg=-,mod=- " — フォローモード: ファイルがディスク上で変わるたび、konoma が自動で"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=white,bg=-,mod=- "F"
