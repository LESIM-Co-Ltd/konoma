  s13 fg=-,bg=-,mod=- "/"
  s14 fg=white,bg=-,mod=- "N"
  s15 fg=-,bg=-,mod=- " では追尾が続き、"
  s16 fg=white,bg=-,mod=- "q"
  s17 fg=-,bg=-,mod=- " でやめます。"
