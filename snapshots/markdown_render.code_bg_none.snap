  s00 fg=-,bg=-,mod=- "や"
L0137 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=D "$H_2O$"
L0138 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "は、文中に置けないので"
  s01 fg=-,bg=-,mod=B "自前の行に持ち上がって"
  s02 fg=-,bg=-,mod=- " "
  s03 fg=-,bg=-,mod=- "画像で描かれる（"
  s04 fg=white,bg=-,mod=- "[ui] math"
  s05 fg=-,bg=-,mod=- "）。ディスプレイ数式は中央寄せ:"
L0139 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=D "$$ \\int_{-\\infty}^{\\infty} e^{-x^2}\\,dx = \\sqrt{\\pi} $$"
L0140 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "通貨（"
  s01 fg=white,bg=-,mod=- "$5"
  s02 fg=-,bg=-,mod=- " や "
  s03 fg=white,bg=-,mod=- "$10"
  s04 fg=-,bg=-,mod=- "）・コード内の "
  s05 fg=white,bg=-,mod=- "`$x$`"
  s06 fg=-,bg=-,mod=- "・エスケープ "
  s07 fg=white,bg=-,mod=- "\\$"
  s08 fg=-,bg=-,mod=- " は数式と誤認しない。"
  s09 fg=-,bg=-,mod=- " "
  s10 fg=-,bg=-,mod=- "RaTeX（純 Rust・KaTeX 品質）でラスタライズするのでブラウザも Node も要らない。"
  s11 fg=-,bg=-,mod=- " "
  s12 fg=white,bg=-,mod=- "math = \"text\""
  s13 fg=-,bg=-,mod=- " にすると生の LaTeX テキストのまま表示する。"
