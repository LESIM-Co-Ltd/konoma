  s02 fg=-,bg=-,mod=- " — 6 章の git スイート一式。たいていは既に入っています。"
L0079 style=fg=-,bg=-,mod=- align=-
L0080 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "画像・SVG・Markdown・Mermaid 図・LaTeX 数式・CSV テーブル・"
  s01 fg=-,bg=-,mod=B "PDF"
  s02 fg=-,bg=-,mod=- "・"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=B "H.264/HEVC 動画のサムネイル"
  s05 fg=-,bg=-,mod=- "・コードは"
  s06 fg=-,bg=-,mod=B "追加インストール不要"
  s07 fg=-,bg=-,mod=- "で、konoma 自身が純 Rust で描きます（macOS に限り、"
  s08 fg=-,bg=-,mod=- " "
  s09 fg=-,bg=-,mod=- "内蔵レンダラが扱えない PDF は OS 同梱の "
  s10 fg=white,bg=-,mod=- "qlmanage"
  s11 fg=-,bg=-,mod=- "/"
  s12 fg=white,bg=-,mod=- "sips"
