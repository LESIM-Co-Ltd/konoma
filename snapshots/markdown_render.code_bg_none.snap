L0046 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "A "
  s01 fg=white,bg=-,mod=- "<table>"
  s02 fg=-,bg=-,mod=- " written as HTML is drawn as a real table too. READMEs reach for this form because a"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "GFM "
  s05 fg=white,bg=-,mod=- "|"
  s06 fg=-,bg=-,mod=- " table cannot put a caption row underneath a row of images. Alignment is read per cell"
  s07 fg=-,bg=-,mod=- " "
  s08 fg=-,bg=-,mod=- "("
  s09 fg=white,bg=-,mod=- "align=\"center\""
  s10 fg=-,bg=-,mod=- "), a "
  s11 fg=white,bg=-,mod=- "<th>"
