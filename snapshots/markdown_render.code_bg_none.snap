L0115 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "Images (inline)"
L0116 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0117 style=fg=-,bg=-,mod=- align=-
L0118 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "A line that is just "
