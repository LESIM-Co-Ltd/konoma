L0083 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "HTML blocks"
L0084 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0085 style=fg=-,bg=-,mod=- align=-
L0086 style=fg=-,bg=-,mod=- align=-
  s00 fg=white,bg=-,mod=- "<details>"
  s01 fg=-,bg=-,mod=- " becomes a collapsible section with a "
  s02 fg=white,bg=-,mod=- "▸"
  s03 fg=-,bg=-,mod=- "/"
  s04 fg=white,bg=-,mod=- "▾"
  s05 fg=-,bg=-,mod=- " marker: "
  s06 fg=white,bg=-,mod=- "Tab"
  s07 fg=-,bg=-,mod=- " focuses the summary,"
  s08 fg=-,bg=-,mod=- " "
  s09 fg=-,bg=-,mod=- "then "
  s10 fg=white,bg=-,mod=- "Space"
  s11 fg=-,bg=-,mod=- " or "
  s12 fg=white,bg=-,mod=- "Enter"
  s13 fg=-,bg=-,mod=- " opens/closes it. By default the "
  s14 fg=white,bg=-,mod=- "open"
  s15 fg=-,bg=-,mod=- " attribute is honored like"
  s16 fg=-,bg=-,mod=- " "
  s17 fg=-,bg=-,mod=- "GitHub ("
  s18 fg=white,bg=-,mod=- "[ui] md_details"
  s19 fg=-,bg=-,mod=- " can force it always open/closed)."
