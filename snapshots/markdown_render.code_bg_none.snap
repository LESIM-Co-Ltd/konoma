  s18 fg=white,bg=-,mod=- "tutorial.md"
  s19 fg=-,bg=-,mod=- " and pressing "
  s20 fg=white,bg=-,mod=- "Enter"
  s21 fg=-,bg=-,mod=- ". That round trip (tree ⇄ full-screen preview)"
  s22 fg=-,bg=-,mod=- " "
  s23 fg=-,bg=-,mod=- "is the core of konoma: no split panes, always the full screen."
L0011 style=fg=-,bg=-,mod=- align=-
L0012 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "2. Follow links with Tab"
L0013 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0014 style=fg=-,bg=-,mod=- align=-
L0015 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Markdown links are focusable. Press "
  s01 fg=white,bg=-,mod=- "Tab"
  s02 fg=-,bg=-,mod=- " repeatedly — the focus (inverted block)"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "walks through every link and checkbox in this document. Try it:"
L0016 style=fg=-,bg=-,mod=- align=-
L0017 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=blue,bg=-,mod=U "\u{f0c1} markdown.md"
  s02 fg=-,bg=-,mod=- " — the Markdown showcase (tables, code, Mermaid, images)"
L0018 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=blue,bg=-,mod=U "\u{f0c1} sample.csv"
  s02 fg=-,bg=-,mod=- " — opens as an aligned table: move cells with "
  s03 fg=white,bg=-,mod=- "h j k l"
  s04 fg=-,bg=-,mod=- ","
  s05 fg=-,bg=-,mod=- " "
  s06 fg=-,bg=-,mod=- "copy a cell/row/column with "
  s07 fg=white,bg=-,mod=- "y"
L0019 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=blue,bg=-,mod=U "\u{f0c1} sample.png"
  s02 fg=-,bg=-,mod=- " — image preview: zoom with "
  s03 fg=white,bg=-,mod=- "+"
  s04 fg=-,bg=-,mod=- "/"
  s05 fg=white,bg=-,mod=- "-"
  s06 fg=-,bg=-,mod=- ", pan with "
  s07 fg=white,bg=-,mod=- "h j k l"
L0020 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=blue,bg=-,mod=U "\u{f0c1} sample.pdf"
  s02 fg=-,bg=-,mod=- " — PDF pages: turn with "
  s03 fg=white,bg=-,mod=- "J"
  s04 fg=-,bg=-,mod=- "/"
  s05 fg=white,bg=-,mod=- "K"
L0021 style=fg=-,bg=-,mod=- align=-
L0022 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Focus one with "
  s01 fg=white,bg=-,mod=- "Tab"
  s02 fg=-,bg=-,mod=- ", press "
  s03 fg=white,bg=-,mod=- "Enter"
  s04 fg=-,bg=-,mod=- " to open it, then "
  s05 fg=white,bg=-,mod=- "q"
  s06 fg=-,bg=-,mod=- " to come back here."
L0023 style=fg=-,bg=-,mod=- align=-
L0024 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "3. Toggle these checkboxes"
L0025 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0026 style=fg=-,bg=-,mod=- align=-
L0027 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Checkboxes are interactive: "
  s01 fg=white,bg=-,mod=- "Tab"
  s02 fg=-,bg=-,mod=- " to focus, "
  s03 fg=white,bg=-,mod=- "Space"
  s04 fg=-,bg=-,mod=- " (or "
  s05 fg=white,bg=-,mod=- "Enter"
  s06 fg=-,bg=-,mod=- ") to toggle."
  s07 fg=-,bg=-,mod=- " "
  s08 fg=-,bg=-,mod=- "The change is written back to this file — you are editing real state, safely"
  s09 fg=-,bg=-,mod=- " "
  s10 fg=-,bg=-,mod=- "(konoma verifies the file on disk before writing a single character)."
L0028 style=fg=-,bg=-,mod=- align=-
L0029 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=cyan,bg=-,mod=B "\u{f096} "
  s02 fg=-,bg=-,mod=- "I scrolled with "
  s03 fg=white,bg=-,mod=- "j"
  s04 fg=-,bg=-,mod=- "/"
  s05 fg=white,bg=-,mod=- "k"
L0030 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=cyan,bg=-,mod=B "\u{f096} "
  s02 fg=-,bg=-,mod=- "I opened a link with "
  s03 fg=white,bg=-,mod=- "Tab"
  s04 fg=-,bg=-,mod=- " + "
  s05 fg=white,bg=-,mod=- "Enter"
  s06 fg=-,bg=-,mod=- " and came back with "
  s07 fg=white,bg=-,mod=- "q"
L0031 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=cyan,bg=-,mod=B "\u{f096} "
  s02 fg=-,bg=-,mod=- "I toggled this checkbox with "
  s03 fg=white,bg=-,mod=- "Space"
L0032 style=fg=-,bg=-,mod=- align=-
L0033 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "4. Search and copy"
L0034 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0035 style=fg=-,bg=-,mod=- align=-
L0036 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "/"
  s02 fg=-,bg=-,mod=- " searches inside a text preview; "
  s03 fg=white,bg=-,mod=- "n"
  s04 fg=-,bg=-,mod=- "/"
  s05 fg=white,bg=-,mod=- "N"
  s06 fg=-,bg=-,mod=- " jump between matches."
L0037 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "R"
  s02 fg=-,bg=-,mod=- " shows this file's raw Markdown source. In raw view (and any code/text file),"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=white,bg=-,mod=- "v"
  s05 fg=-,bg=-,mod=- " starts a character selection and "
  s06 fg=white,bg=-,mod=- "V"
  s07 fg=-,bg=-,mod=- " a line selection — move with "
  s08 fg=white,bg=-,mod=- "h j k l"
  s09 fg=-,bg=-,mod=- ","
  s10 fg=-,bg=-,mod=- " "
  s11 fg=-,bg=-,mod=- "copy with "
  s12 fg=white,bg=-,mod=- "y"
  s13 fg=-,bg=-,mod=- ". "
  s14 fg=white,bg=-,mod=- "Y"
  s15 fg=-,bg=-,mod=- " copies an "
  s16 fg=white,bg=-,mod=- "@path#L12"
  s17 fg=-,bg=-,mod=- " reference for AI chats."
L0038 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=- "From the tree, "
  s02 fg=white,bg=-,mod=- "y"
  s03 fg=-,bg=-,mod=- " opens a copy menu: file name, relative/full path, or an"
  s04 fg=-,bg=-,mod=- " "
  s05 fg=white,bg=-,mod=- "@relative/path"
  s06 fg=-,bg=-,mod=- " reference."
L0039 style=fg=-,bg=-,mod=- align=-
L0040 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "5. The tree is a file manager"
L0041 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0042 style=fg=-,bg=-,mod=- align=-
L0043 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Back in the tree ("
  s01 fg=white,bg=-,mod=- "q"
  s02 fg=-,bg=-,mod=- "):"
L0044 style=fg=-,bg=-,mod=- align=-
L0045 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "/"
  s02 fg=-,bg=-,mod=- " filters entries as you type; "
  s03 fg=white,bg=-,mod=- "Esc"
  s04 fg=-,bg=-,mod=- " clears."
L0046 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "Space"
  s02 fg=-,bg=-,mod=- " opens the file-management menu: create ("
  s03 fg=white,bg=-,mod=- "n"
  s04 fg=-,bg=-,mod=- "), rename ("
  s05 fg=white,bg=-,mod=- "r"
  s06 fg=-,bg=-,mod=- "), delete ("
  s07 fg=white,bg=-,mod=- "d"
  s08 fg=-,bg=-,mod=- " —"
  s09 fg=-,bg=-,mod=- " "
  s10 fg=-,bg=-,mod=- "to the trash, with confirmation), copy/cut/paste ("
  s11 fg=white,bg=-,mod=- "c"
  s12 fg=-,bg=-,mod=- "/"
  s13 fg=white,bg=-,mod=- "x"
  s14 fg=-,bg=-,mod=- "/"
  s15 fg=white,bg=-,mod=- "p"
  s16 fg=-,bg=-,mod=- ")."
L0047 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "."
  s02 fg=-,bg=-,mod=- " shows dotfiles, "
  s03 fg=white,bg=-,mod=- "s"
  s04 fg=-,bg=-,mod=- " opens the sort menu, "
  s05 fg=white,bg=-,mod=- "i"
  s06 fg=-,bg=-,mod=- " shows file info."
L0048 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "m"
  s02 fg=-,bg=-,mod=- " + a letter bookmarks the cursor item (lowercase = this project, uppercase ="
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "global). "
  s05 fg=white,bg=-,mod=- "'"
  s06 fg=-,bg=-,mod=- " opens the bookmark list — press the letter to jump. Both work from"
  s07 fg=-,bg=-,mod=- " "
  s08 fg=-,bg=-,mod=- "previews too, bookmarking the file you are viewing."
L0049 style=fg=-,bg=-,mod=- align=-
L0050 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "6. Git, live"
L0051 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0052 style=fg=-,bg=-,mod=- align=-
L0053 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "If this directory is inside a git repository: "
  s01 fg=white,bg=-,mod=- "o"
  s02 fg=-,bg=-,mod=- " opens the changes hub"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "(stage/unstage/commit), "
  s05 fg=white,bg=-,mod=- "d"
  s06 fg=-,bg=-,mod=- " on a changed file shows its full-screen diff,"
  s07 fg=-,bg=-,mod=- " "
  s08 fg=-,bg=-,mod=- "and inside the hub "
  s09 fg=white,bg=-,mod=- "l"
  s10 fg=-,bg=-,mod=- " is the log and "
  s11 fg=white,bg=-,mod=- "g"
  s12 fg=-,bg=-,mod=- " the commit graph. Modified files"
  s13 fg=-,bg=-,mod=- " "
  s14 fg=-,bg=-,mod=- "are colored in the tree, and code previews get an editor-style change gutter."
L0054 style=fg=-,bg=-,mod=- align=-
L0055 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "7. Watch an AI agent work"
L0056 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0057 style=fg=-,bg=-,mod=- align=-
L0058 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "konoma's flagship trick, for the \"konoma on the left, coding agent on the right\""
  s01 fg=-,bg=-,mod=- " "
  s02 fg=-,bg=-,mod=- "layout:"
L0059 style=fg=-,bg=-,mod=- align=-
L0060 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "F"
  s02 fg=-,bg=-,mod=- " — follow mode: whenever a file changes on disk, konoma automatically shows"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "the diff of "
  s05 fg=-,bg=-,mod=B "what changed since you pressed "
  s06 fg=white,bg=-,mod=- "F"
  s07 fg=-,bg=-,mod=- " — not the whole uncommitted"
  s08 fg=-,bg=-,mod=- " "
  s09 fg=-,bg=-,mod=- "diff, so your own earlier edits stay out of the way. "
  s10 fg=white,bg=-,mod=- "f"
  s11 fg=-,bg=-,mod=- " switches between the"
  s12 fg=-,bg=-,mod=- " "
  s13 fg=-,bg=-,mod=- "two. Scrolling and "
  s14 fg=white,bg=-,mod=- "n"
  s15 fg=-,bg=-,mod=- "/"
  s16 fg=white,bg=-,mod=- "N"
  s17 fg=-,bg=-,mod=- " keep following; "
  s18 fg=white,bg=-,mod=- "q"
  s19 fg=-,bg=-,mod=- " stops."
L0061 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "C"
  s02 fg=-,bg=-,mod=- " — flat list of every file with uncommitted changes; "
  s03 fg=white,bg=-,mod=- "n"
  s04 fg=-,bg=-,mod=- "/"
  s05 fg=white,bg=-,mod=- "N"
  s06 fg=-,bg=-,mod=- " jump through them."
L0062 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=white,bg=-,mod=- "y"
  s02 fg=-,bg=-,mod=- " → "
  s03 fg=white,bg=-,mod=- "@"
  s04 fg=-,bg=-,mod=- " / "
  s05 fg=white,bg=-,mod=- "Y"
  s06 fg=-,bg=-,mod=- " — copy "
  s07 fg=white,bg=-,mod=- "@path"
  s08 fg=-,bg=-,mod=- " / "
  s09 fg=white,bg=-,mod=- "@path#L12-34"
  s10 fg=-,bg=-,mod=- " references to paste into the"
  s11 fg=-,bg=-,mod=- " "
  s12 fg=-,bg=-,mod=- "agent conversation."
L0063 style=fg=-,bg=-,mod=- align=-
L0064 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "8. If a preview says "
  s01 fg=white,bg=-,mod=- "[can not preview]"
L0065 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0066 style=fg=-,bg=-,mod=- align=-
L0067 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Nothing is broken. konoma hands a few formats to external tools, and when one is"
  s01 fg=-,bg=-,mod=- " "
  s02 fg=-,bg=-,mod=- "missing it says so instead of crashing — everything else keeps working. Install"
  s03 fg=-,bg=-,mod=- " "
  s04 fg=-,bg=-,mod=- "what you actually want:"
L0068 style=fg=-,bg=-,mod=- align=-
L0069 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=I "▎ "
  s01 fg=-,bg=-,mod=- "                                                                                            "
  s02 fg=gray,bg=-,mod=DI " bash "
L0070 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
  s01 fg=rgb(92,99,112),bg=-,mod=I "#"
  s02 fg=rgb(92,99,112),bg=-,mod=I " macOS"
L0071 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
  s01 fg=rgb(224,108,117),bg=-,mod=- "brew"
  s02 fg=rgb(171,178,191),bg=-,mod=- " install ffmpeg"
L0072 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
L0073 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
  s01 fg=rgb(92,99,112),bg=-,mod=I "#"
  s02 fg=rgb(92,99,112),bg=-,mod=I " Debian / Ubuntu"
L0074 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
  s01 fg=rgb(224,108,117),bg=-,mod=- "sudo"
  s02 fg=rgb(171,178,191),bg=-,mod=- " apt install ffmpeg"
L0075 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=- "▎ "
L0076 style=fg=-,bg=-,mod=- align=-
L0077 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=B "ffmpeg"
  s02 fg=-,bg=-,mod=- " (or "
  s03 fg=white,bg=-,mod=- "ffmpegthumbnailer"
  s04 fg=-,bg=-,mod=- ") — the representative frame of the videos konoma"
  s05 fg=-,bg=-,mod=- " "
  s06 fg=-,bg=-,mod=- "can't decode itself: VP9, AV1, the older codecs, "
  s07 fg=white,bg=-,mod=- ".avi"
  s08 fg=-,bg=-,mod=- "."
  s09 fg=-,bg=-,mod=- " "
  s10 fg=-,bg=-,mod=B "H.264 and HEVC inside "
  s11 fg=white,bg=-,mod=- ".mp4"
  s12 fg=-,bg=-,mod=B "/"
  s13 fg=white,bg=-,mod=- ".m4v"
  s14 fg=-,bg=-,mod=B "/"
  s15 fg=white,bg=-,mod=- ".mov"
  s16 fg=-,bg=-,mod=B " and "
  s17 fg=white,bg=-,mod=- ".mkv"
  s18 fg=-,bg=-,mod=B "/"
  s19 fg=white,bg=-,mod=- ".webm"
  s20 fg=-,bg=-,mod=B " need nothing"
  s21 fg=-,bg=-,mod=- " — konoma"
  s22 fg=-,bg=-,mod=- " "
  s23 fg=-,bg=-,mod=- "decodes those itself, including what an iPhone records by default."
L0078 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=B "git"
  s02 fg=-,bg=-,mod=- " — the whole git suite in section 6. You almost certainly have it already."
L0079 style=fg=-,bg=-,mod=- align=-
L0080 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "Images, SVG, Markdown, Mermaid diagrams, LaTeX math, CSV tables, "
  s01 fg=-,bg=-,mod=B "PDF"
  s02 fg=-,bg=-,mod=- ", "
  s03 fg=-,bg=-,mod=B "H.264 and"
  s04 fg=-,bg=-,mod=- " "
  s05 fg=-,bg=-,mod=B "HEVC video thumbnails"
  s06 fg=-,bg=-,mod=- ", and code need "
  s07 fg=-,bg=-,mod=B "nothing extra"
  s08 fg=-,bg=-,mod=- " — they are rendered inside"
  s09 fg=-,bg=-,mod=- " "
  s10 fg=-,bg=-,mod=- "konoma, in pure Rust."
  s11 fg=-,bg=-,mod=- " "
  s12 fg=-,bg=-,mod=- "(On macOS only, a PDF the built-in renderer can't handle falls back to the"
  s13 fg=-,bg=-,mod=- " "
  s14 fg=-,bg=-,mod=- "system's own "
  s15 fg=white,bg=-,mod=- "qlmanage"
  s16 fg=-,bg=-,mod=- "/"
  s17 fg=white,bg=-,mod=- "sips"
  s18 fg=-,bg=-,mod=- " for its first page — nothing to install there"
  s19 fg=-,bg=-,mod=- " "
  s20 fg=-,bg=-,mod=- "either.) The picture formats are drawn as real pixels in any terminal that"
  s21 fg=-,bg=-,mod=- " "
  s22 fg=-,bg=-,mod=- "speaks a graphics protocol — kitty graphics (Ghostty, kitty, WezTerm, Konsole),"
  s23 fg=-,bg=-,mod=- " "
  s24 fg=-,bg=-,mod=- "iTerm2, or sixel — and degrade to a coarse but visible half-block approximation"
  s25 fg=-,bg=-,mod=- " "
  s26 fg=-,bg=-,mod=- "anywhere else. Text previews work in any terminal."
L0081 style=fg=-,bg=-,mod=- align=-
L0082 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=cyan,bg=-,mod=B "\u{f096} "
  s02 fg=-,bg=-,mod=- "I know what to install if I need it"
L0083 style=fg=-,bg=-,mod=- align=-
L0084 style=fg=cyan,bg=-,mod=B align=-
  s00 fg=-,bg=-,mod=- "Where to go next"
L0085 style=fg=-,bg=-,mod=- align=-
  s00 fg=cyan,bg=-,mod=D "────────────────────────────────────────────────────────────────────────────────────────────────────"
L0086 style=fg=-,bg=-,mod=- align=-
L0087 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=- "Press "
  s02 fg=white,bg=-,mod=- "?"
  s03 fg=-,bg=-,mod=- " on any screen — every view documents its own keys."
L0088 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=- "The full manual (guides, configuration, keymap) lives at the documentation site"
  s02 fg=-,bg=-,mod=- " "
  s03 fg=-,bg=-,mod=- "linked from the README, and "
  s04 fg=white,bg=-,mod=- "config.example.toml"
  s05 fg=-,bg=-,mod=- " documents every setting inline."
L0089 style=fg=-,bg=-,mod=- align=-
L0090 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "One last box to tick:"
L0091 style=fg=-,bg=-,mod=- align=-
L0092 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=cyan,bg=-,mod=B "\u{f096} "
  s02 fg=-,bg=-,mod=- "Done! Enjoy konoma."
