L0077 style=fg=-,bg=-,mod=- align=-
  s00 fg=-,bg=-,mod=- "- "
  s01 fg=-,bg=-,mod=B "ffmpeg"
  s02 fg=-,bg=-,mod=- "（または "
  s03 fg=white,bg=-,mod=- "ffmpegthumbnailer"
  s04 fg=-,bg=-,mod=- "）— konoma 自身がデコードできない動画の"
  s05 fg=-,bg=-,mod=- " "
  s06 fg=-,bg=-,mod=- "代表フレーム: VP9・AV1・旧世代のコーデック・"
  s07 fg=white,bg=-,mod=- ".avi"
  s08 fg=-,bg=-,mod=- "。"
  s09 fg=-,bg=-,mod=- " "
  s10 fg=white,bg=-,mod=- ".mp4"
  s11 fg=-,bg=-,mod=B "/"
  s12 fg=white,bg=-,mod=- ".m4v"
  s13 fg=-,bg=-,mod=B "/"
  s14 fg=white,bg=-,mod=- ".mov"
  s15 fg=-,bg=-,mod=B " と "
  s16 fg=white,bg=-,mod=- ".mkv"
  s17 fg=-,bg=-,mod=B "/"
  s18 fg=white,bg=-,mod=- ".webm"
  s19 fg=-,bg=-,mod=B " の H.264 と HEVC（iPhone の既定録画形式）は"
  s20 fg=-,bg=-,mod=- " "
  s21 fg=-,bg=-,mod=B "不要"
  s22 fg=-,bg=-,mod=- "です（konoma 自身がデコードします）。"
